# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (Neon) — Step 2 ----
DATABASE_URL=

# ---- Auth.js — Step 3 ----
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Models / AI providers ----
DEFAULT_MODEL=ollama:qwen2.5
# Ollama (local dev default)
OLLAMA_BASE_URL=http://localhost:11434/api
# Gemini (production default) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter (fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq (fast inference, chat only — no embeddings) — https://console.groq.com/keys
GROQ_API_KEY=

# ---- Live web search (current-event verification) ----
# Set ONE for reliable current-event answers. Without a key the layer falls back
# to the keyless DuckDuckGo scraper (rate-limited → current-event queries will
# frequently REFUSE rather than answer, by design — never hallucinate).
# Website summarization ("summarize xyz.com") works WITHOUT any key.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Google Apps Script webhook for onboarding -> Sheets (optional; failures are non-fatal)
GOOGLE_SHEETS_WEBHOOK_URL=

# ---- Production email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=HajiHaz AI <noreply@hajihazai.com>

# ---- Shared rate limiting (Upstash Redis REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Error monitoring (Sentry) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
